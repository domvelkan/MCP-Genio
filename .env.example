# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(48))"
GENIO_MCP_TOKEN=
# Comma-separated Telegram chat IDs allowed to operate /cockpit. Use the admin chat ID from Andaria.
TELEGRAM_ALLOWED_CHAT_IDS=

# Hosted model APIs; one can fall back to the other when both are configured.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
ANDARIA_SITE=https://andaria.com.br

# Services accessible from the cloud. Local 127.0.0.1 URLs will not work from Render.
COMFYUI_URL=
N8N_URL=
N8N_API_KEY=
N8N_ALLOWED_WORKFLOWS=
N8N_WEBHOOK_BASE=
# Optional JSON object mapping n8n workflow IDs to their actual webhook paths.
# Example: {"workflow-id-1":"publish-post","workflow-id-2":"generate-media"}
N8N_WORKFLOW_WEBHOOK_MAP={}
# Optional health endpoint only; this does not execute Hermes commands.
HERMES_HEALTH_URL=
LOG_LEVEL=INFO
