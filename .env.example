# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(48))"
GENIO_MCP_TOKEN=
# Separate secret shared only between the existing Andaria bot service and MCP-Genio.
COCKPIT_BRIDGE_TOKEN=

# Hosted model APIs; one can fall back to the other when both are configured.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
ANDARIA_SITE=https://andaria.com.br
# Fallbacks use Andaria's existing OpenRouter key and Hugging Face inference token.
ANDARIA_AI_URL=https://andaria.onrender.com/api/cockpit/ai
ANDARIA_VISUAL_URL=https://andaria.onrender.com/api/cockpit/visual

# Kernel is the policy authority for all side-effecting execution. Leave actions blocked until deployed/configured.
KERNEL_GATEWAY_URL=
KERNEL_GATEWAY_TOKEN=

# Services accessible from the cloud. Local 127.0.0.1 URLs will not work from Render.
COMFYUI_URL=
N8N_URL=
N8N_API_KEY=
N8N_ALLOWED_WORKFLOWS=
N8N_WEBHOOK_BASE=
# Optional JSON object mapping n8n workflow IDs to their actual webhook paths.
# Example: {"workflow-id-1":"publish-post","workflow-id-2":"generate-media"}
N8N_WORKFLOW_WEBHOOK_MAP={}
# Optional health endpoint only; this does not execute Hermes commands.
HERMES_HEALTH_URL=
LOG_LEVEL=INFO
